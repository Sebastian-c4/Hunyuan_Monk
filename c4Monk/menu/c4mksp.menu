-----------------------
-- 混元武僧 · 技能点面板
-- 左栏：身法 / 高等身法 / 心法×4     右栏：拳法×7
-- 每一行 = 图标 + 可点击的文字（点整行加点）；不可加时整行变灰
-- 文字与可用状态都由 M_C4MK.lua 提供
-----------------------

menu
{
	name "C4MonkSp_Menu"
	ignoreesc

	-- 全屏透明层：让引擎在面板外也能正常恢复光标（参照 B3Timer.menu）
	label
	{
		area 0 0 2147483647 2147483647
		enabled true
	}

	-- 面板背景（占位，后续换 BAM）
	label
	{
		area 100 120 820 470
		enabled true
		rectangle 5
		rectangle opacity 800
	}

	-- 标题
	label
	{
		area 120 134 360 26
		enabled true
		text "混元武僧 · 技能点"
		text align left center
	}

	-- 剩余 / 已加 / 共
	label
	{
		area 500 134 400 26
		enabled true
		text lua "C4MK_Summary"
		text align right center
	}

	--------------- 左栏标题 ---------------

	label
	{
		area 120 172 240 20
		enabled true
		text "〔身法〕"
		text align left center
	}

	label
	{
		area 120 268 240 20
		enabled true
		text "〔心法〕"
		text align left center
	}

